; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Đại Việt Chiến"
config/description="Game thẻ bài chiến thuật turn-based đề tài Đại Việt - Godot 4 Prototype"
run/main_scene="res://scenes/auth_login.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.04, 0.07, 0.12, 1)

[autoload]

NetworkClient="*res://scripts/network/network_client.gd"
AuthManager="*res://scripts/network/auth_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.06, 0.09, 0.14, 1)
